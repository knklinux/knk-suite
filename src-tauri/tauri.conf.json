{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "knkLinux Security Workbench",
  "version": "4.2.3",
  "identifier": "com.knklinux.securityworkbench",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "knkLinux // Security Workbench",
        "url": "http://127.0.0.1:8086",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "assistant",
        "title": "KNK Assistant",
        "url": "http://127.0.0.1:8086/#assistant",
        "width": 380,
        "height": 520,
        "minWidth": 320,
        "minHeight": 380,
        "resizable": true,
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8086 ws://127.0.0.1:8086; img-src 'self' data: blob: http://127.0.0.1:8086; media-src 'self' blob: http://127.0.0.1:8086; worker-src 'self' blob:; frame-src 'self' https://player.twitch.tv https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' blob: http://127.0.0.1:8086 ws://127.0.0.1:8086 http://127.0.0.1:11434; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "publisher": "knkLinux",
    "copyright": "knkLinux",
  "license": "MIT",
  "licenseFile": "../LICENSE",
    "icon": ["../assets/knklinux.png", "../assets/knklinux.ico"],
    "resources": {
      "../backend": "backend",
      "../frontend/dist": "frontend/dist",
      "../assets": "assets",
      "../data": "data",
      "../vault-knklinux": "vault-knklinux",
      "../node_modules": "node_modules"
    }
  }
}
